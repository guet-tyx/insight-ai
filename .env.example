# ===== Insight AI 环境变量模板（复制为 .env 后填写）=====

# ---- Embedding（免费：硅基流动 SiliconFlow，BAAI/bge-m3，1024 维）----
# 注册：https://cloud.siliconflow.cn  → 控制台 → API 密钥
SILICONFLOW_API_KEY=sk-xxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# ⚠️ 关键坑（2026-08-10 实测）：用 langchain-openai 的 OpenAIEmbeddings 对接时
#    必须传 check_embedding_ctx_length=False！
#    默认 True 会把文本 tiktoken 化成 token ID 数组发给硅基流动，
#    API 不报错但嵌入结果失真，检索 Top1 会命中无关文档。
#    参考实测脚本 backend/scripts/verify_embedding.py
# 向量归一化（bge-m3 建议开启 cosine 检索前归一化；Milvus 侧 COSINE 指标可不设）
# EMBEDDING_NORMALIZE=false

# ---- LLM 推理（SenseNova 网关，OpenAI 兼容协议）----
# OPENAI_API_KEY=sk-xxxxxxxx   ← 网关 Token/Key
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=deepseek-v4-flash

# ---- LangSmith 可观测性（计划 Week 11 全链路 Trace，可选）----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2-xxxxxxxx
# LANGCHAIN_PROJECT=insight-ai

# ---- 基础设施连接（docker-compose.yml 端口）----
MILVUS_URI=http://127.0.0.1:19530
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=insightai-neo4j
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT 认证（Week 1 实现）----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 浏览器采集（W3，可选）----
# 代理池（逗号分隔）；空 = 直连（本机开发默认；W6 接入真实代理池）
# BROWSER_PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# ---- 代理（可选，国内网络拉取依赖时使用）----
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897